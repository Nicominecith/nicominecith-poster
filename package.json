{
  "name": "nicominecith-poster",
  "version": "0.1.0",
  "description": "Turn an album, a film or a book into a print-ready poster, right in the browser.",
  "homepage": "https://github.com/Nicominecith-clips/nicominecith-poster",
  "author": "Nicominecith_clips",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nicominecith-clips/nicominecith-poster.git"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t serve -p music film book --parallel=3",
    "build": "nx run site:build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint -- --fix",
    "test": "nx run-many -t test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:wasm": "nx run renderer:build-wasm",
    "rust:check": "nx run renderer:rust-check",
    "rust:test": "nx run renderer:rust-test",
    "build:fonts": "nx run fonts:build-sfnt",
    "build:script-faces": "nx run fonts:build-script-faces"
  },
