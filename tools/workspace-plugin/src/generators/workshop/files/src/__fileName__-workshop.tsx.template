import { errAsync, okAsync } from "neverthrow";
import { createCatalog } from "@freetsy/catalog";
import { defineCatalogWorkshop } from "@freetsy/workshop";

type <%= className %>Summary = { id: string; title: string };

type <%= className %>Detail = <%= className %>Summary & { text: string };

const <%= propertyName %>Catalog = createCatalog<<%= className %>Summary, <%= className %>Detail>({
  id: "<%= name %>",
  search: () => okAsync([]),
  detail: (id) => errAsync(new Error(`<%= name %>: no entry ${id}`)),
});

export const <%= propertyName %>Workshop = defineCatalogWorkshop({
  kind: "<%= kind %>",
  catalog: <%= propertyName %>Catalog,
  toHit: (entry) => ({ id: entry.id, title: entry.title, facts: "", source: "", tag: "" }),
  toSummary: (entry) => ({ title: entry.title, facts: "" }),
  toContent: (entry) => ({ title: entry.title, freeformText: entry.text }),
  sources: () => null,
});
